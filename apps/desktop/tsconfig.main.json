{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": [
    "electron/**/*.ts",
    "shared/**/*.ts",
    "vite.*.config.ts",
    "src/development-csp.ts",
    "src/startup-screen-document.ts",
    "src/vite-env.d.ts"
  ],
  "exclude": ["electron/preload.ts"]
}
