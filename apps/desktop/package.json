{
  "name": "@mailrovers/desktop",
  "version": "0.1.0",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "build": "tsc -b tsconfig.json --force && electron-forge package",
    "typecheck": "tsc -b tsconfig.json --force",
    "test": "vitest run --passWithNoTests",
    "fixture:seed": "ELECTRON_RUN_AS_NODE=1 electron ../../node_modules/tsx/dist/cli.mjs perf/seed.ts",
    "perf": "tsx perf/query.ts",
    "package:mac": "electron-forge package --platform=darwin && codesign --force --deep --sign - out/MailRovers-darwin-$(uname -m)/MailRovers.app",
    "smoke:packaged": "tsx perf/smoke-packaged.ts",
    "performance:packaged": "pnpm build && tsx perf/smoke-packaged.ts --performance --idle-ms=60000 --mode=main"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@mailrovers/mail-ai": "workspace:*",
    "@mailrovers/mail-application": "workspace:*",
    "@mailrovers/mail-contracts": "workspace:*",
    "@mailrovers/mail-domain": "workspace:*",
    "@mailrovers/mail-store-sqlite": "workspace:*",
    "@mailrovers/mail-sync": "workspace:*",
    "@mailrovers/platform-electron": "workspace:*",
    "@mailrovers/provider-gmail": "workspace:*",
    "@mailrovers/test-support": "workspace:*",
    "@tanstack/react-query": "5.74.9",
    "@tanstack/react-virtual": "3.13.9",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.8.0",
    "@electron-forge/maker-dmg": "7.8.0",
    "@electron-forge/plugin-auto-unpack-natives": "7.8.0",
    "@electron-forge/plugin-vite": "7.8.0",
    "@electron/rebuild": "3.7.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1",
    "electron": "43.1.0",
    "shadcn": "^4.13.0",
    "tsx": "4.19.3",
    "vite": "6.3.4",
    "vitest": "3.1.3"
  },
  "productName": "MailRovers"
}
