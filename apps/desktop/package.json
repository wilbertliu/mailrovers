{
  "name": "@mailrovers/desktop",
  "version": "0.1.0",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "node ./scripts/set-electron-app-name.cjs && electron-forge start",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "build": "tsc -b tsconfig.json --force && electron-forge package",
    "typecheck": "tsc -b tsconfig.json --force && tsc -p tsconfig.storybook.json --noEmit",
    "test": "ELECTRON_RUN_AS_NODE=1 electron ../../node_modules/vitest/vitest.mjs run --passWithNoTests",
    "native:rebuild": "electron-rebuild -f -w better-sqlite3 -m ../.. -v 43.1.0",
    "fixture:seed": "ELECTRON_RUN_AS_NODE=1 electron ../../node_modules/tsx/dist/cli.mjs perf/seed.ts",
    "perf": "ELECTRON_RUN_AS_NODE=1 electron ../../node_modules/tsx/dist/cli.mjs perf/query.ts",
    "package:mac": "electron-forge package --platform=darwin && codesign --force --deep --sign - out/MailRovers-darwin-$(uname -m)/MailRovers.app",
    "smoke:packaged": "ELECTRON_RUN_AS_NODE=1 electron ../../node_modules/tsx/dist/cli.mjs perf/smoke-packaged.ts",
    "smoke:packaged:default-host": "ELECTRON_RUN_AS_NODE=1 electron ../../node_modules/tsx/dist/cli.mjs perf/smoke-packaged.ts --default-host",
    "performance:packaged": "pnpm build && ELECTRON_RUN_AS_NODE=1 electron ../../node_modules/tsx/dist/cli.mjs perf/smoke-packaged.ts --performance --idle-ms=60000 --default-host",
    "performance:packaged:main": "pnpm build && ELECTRON_RUN_AS_NODE=1 electron ../../node_modules/tsx/dist/cli.mjs perf/smoke-packaged.ts --performance --idle-ms=60000 --mode=main",
    "performance:packaged:pending-fts": "pnpm build && ELECTRON_RUN_AS_NODE=1 electron ../../node_modules/tsx/dist/cli.mjs perf/smoke-packaged.ts --scenario=pending-fts-backfill --idle-ms=0 --mode=main",
    "perf:worker-rpc-clone": "ELECTRON_RUN_AS_NODE=1 electron ../../node_modules/tsx/dist/cli.mjs perf/worker-rpc-clone-probe.ts",
    "perf:isolated-idle-series": "ELECTRON_RUN_AS_NODE=1 electron ../../node_modules/tsx/dist/cli.mjs perf/run-isolated-idle-series.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@mailrovers/mail-ai": "workspace:*",
    "@mailrovers/mail-application": "workspace:*",
    "@mailrovers/mail-contracts": "workspace:*",
    "@mailrovers/mail-domain": "workspace:*",
    "@mailrovers/mail-store-sqlite": "workspace:*",
    "@mailrovers/mail-sync": "workspace:*",
    "@mailrovers/platform-electron": "workspace:*",
    "@mailrovers/provider-gmail": "workspace:*",
    "@mailrovers/test-support": "workspace:*",
    "@shadcn/react": "^0.2.1",
    "@tanstack/react-query": "5.74.9",
    "@tanstack/react-virtual": "3.13.9",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.8.0",
    "@electron-forge/maker-dmg": "7.8.0",
    "@electron-forge/plugin-auto-unpack-natives": "7.8.0",
    "@electron-forge/plugin-vite": "7.8.0",
    "@electron/rebuild": "3.7.2",
    "@storybook/addon-a11y": "10.5.0",
    "@storybook/react-vite": "10.5.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1",
    "electron": "43.1.0",
    "shadcn": "^4.13.0",
    "storybook": "10.5.0",
    "tsx": "4.19.3",
    "vite": "6.3.4",
    "vitest": "3.1.3"
  },
  "productName": "MailRovers"
}
