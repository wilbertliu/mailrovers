{
  "name": "mailrovers",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "fixture:seed": "pnpm --filter @mailrovers/desktop fixture:seed",
    "package:mac": "pnpm --filter @mailrovers/desktop package:mac",
    "smoke:packaged": "pnpm --filter @mailrovers/desktop smoke:packaged",
    "performance:packaged": "pnpm --filter @mailrovers/desktop performance:packaged"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "typescript": "7.0.2",
    "vitest": "3.1.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@10.12.1"
}
