{
  "name": "mailrovers",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "pnpm --filter @mailrovers/desktop native:rebuild",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm native:check && pnpm -r test",
    "native:check": "ELECTRON_RUN_AS_NODE=1 electron scripts/check-native-abi.cjs",
    "lint": "node scripts/check-react-lifecycle.cjs && oxlint --type-aware --deny-warnings .",
    "lint:fix": "node scripts/check-react-lifecycle.cjs && oxlint --type-aware --deny-warnings --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "fixture:seed": "pnpm --filter @mailrovers/desktop fixture:seed",
    "package:mac": "pnpm --filter @mailrovers/desktop package:mac",
    "smoke:packaged": "pnpm --filter @mailrovers/desktop smoke:packaged",
    "smoke:packaged:default-host": "pnpm --filter @mailrovers/desktop smoke:packaged:default-host",
    "performance:packaged": "pnpm --filter @mailrovers/desktop performance:packaged",
    "performance:packaged:main": "pnpm --filter @mailrovers/desktop performance:packaged:main",
    "performance:packaged:pending-fts": "pnpm --filter @mailrovers/desktop performance:packaged:pending-fts"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tailwindcss": "1.3.5",
    "oxlint-tsgolint": "0.24.0",
    "typescript": "7.0.2",
    "vitest": "3.1.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@10.12.1"
}
