{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "import/no-unassigned-import": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useEffect", "useInsertionEffect", "useLayoutEffect"],
            "message": "Generic React effects are forbidden in checked-in application code. Use events, external stores, coordinators, or callback-ref cleanup."
          }
        ]
      }
    ],
    "no-restricted-properties": [
      "error",
      {
        "property": "useEffect",
        "message": "Generic React effects are forbidden in checked-in application code."
      },
      {
        "property": "useInsertionEffect",
        "message": "Generic React effects are forbidden in checked-in application code."
      },
      {
        "property": "useLayoutEffect",
        "message": "Generic React effects are forbidden in checked-in application code."
      }
    ],
    "react/react-in-jsx-scope": "off",
    "typescript/no-explicit-any": "error",
    "unicorn/require-module-specifiers": "off",
    "unicorn/require-post-message-target-origin": "off"
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["apps/desktop/src/components/ui/**/*.{ts,tsx}"],
      "rules": {
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "no-restricted-imports": "off",
        "typescript/restrict-template-expressions": "off"
      }
    }
  ]
}
